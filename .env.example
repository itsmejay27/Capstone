# =============================================================================
# Occidental Mindoro State College (OMSC) Capstone System
# Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# =============================================================================

# 1. Database (Supabase / PostgreSQL)
# Required for persistent classrooms, exams, question bank, and student attempts.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# 2. AI Question Generation (Google Gemini)
# Optional: Required if using Google Gemini to generate exam questions or reviewers.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 3. Google One-Tap Sign-In / OAuth
# Optional: Required for Google Sign-In button on the login screen.
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# WARNING: a VITE_* variable is inlined into the public JS bundle and is readable by anyone
# who opens devtools on the deployed site. A Google *client secret* must never be shipped to
# a browser — the One-Tap / implicit flow does not need it. Remove this from .env and from
# your Google Cloud client unless a server-side exchange actually uses it.
VITE_GOOGLE_CLIENT_SECRET=

# =============================================================================
# 4. Transactional email (Resend) — SERVER SIDE ONLY
# These are read by the `send-email` Supabase Edge Function, NOT by the browser.
# They are intentionally NOT prefixed with VITE_: that prefix would inline them into the
# public bundle, letting anyone send mail as your domain and burn your quota.
#
# Set them as Supabase secrets, not just in .env:
#   supabase secrets set RESEND_API_KEY=re_xxxxxxxx
#   supabase secrets set RESEND_FROM="OMSC Exam Generator <no-reply@yourdomain.edu.ph>"
#   supabase functions deploy send-email
#
# Until a domain is verified in Resend, `onboarding@resend.dev` only delivers to the address
# that owns the Resend account.
# =============================================================================
RESEND_API_KEY=re_your_resend_key_here
RESEND_FROM="OMSC Exam Generator <onboarding@resend.dev>"


# =============================================================================
# 5. Payments (PayMongo) — SERVER SIDE ONLY
# Read by api/paymongo.ts and api/paymongo-webhook.ts on Vercel. Never prefix with VITE_:
# the secret key can charge cards and read every transaction on the merchant account.
#
# Use sk_test_ keys while developing — test-mode checkouts accept PayMongo's test card
# numbers and move no real money. Switch to sk_live_ only in the Production environment.
#
# PAYMONGO_WEBHOOK_SECRET comes from the webhook you register in PayMongo (it starts with
# whsk_). Without it the webhook refuses every event, so no plan can activate.
# =============================================================================
PAYMONGO_SECRET_KEY=sk_test_your_paymongo_secret_key
# Optional: comma-separated checkout methods (default: qrph)
PAYMONGO_PAYMENT_METHODS=qrph
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_signing_secret

# The server needs to write subscriptions, which the browser is (deliberately) not allowed
# to do. Use the service_role key or an sb_secret_ key from Supabase → Project Settings →
# API Keys. SERVER SIDE ONLY — this key bypasses row-level security entirely.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_supabase_secret_key
