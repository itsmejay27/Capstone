# Copy to .env.local and fill in real values. Never commit .env.local.

# Client-side. Exposed in the browser bundle by design; protected by RLS.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Server-side ONLY. Bypasses RLS. Never prefix with VITE_ and never import
# it from src/app/** — it would be inlined into the public bundle.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx
