# =============================================================================
# Occidental Mindoro State College (OMSC) Capstone System
# Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# =============================================================================

# 1. Database (Supabase / PostgreSQL)
# Required for persistent classrooms, exams, question bank, and student attempts.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# 2. AI Question Generation (Google Gemini)
# Optional: Required if using Google Gemini to generate exam questions or reviewers.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 3. Google One-Tap Sign-In / OAuth
# Optional: Required for Google Sign-In button on the login screen.
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=your_google_client_secret

